# Sao chép tệp này thành .env rồi điền giá trị thật. KHÔNG commit tệp .env.

# Khoá API VirusTotal (miễn phí): https://www.virustotal.com → đăng ký → API Key
VIRUSTOTAL_API_KEY=

# Tài khoản Quản trị viên (chỉ dùng khi tạo data/users.json lần đầu). Bỏ trống = admin / admin123 (chỉ để demo!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Khoá ký phiên đăng nhập (bỏ trống = tự sinh và lưu trong data/.auth_secret)
AUTH_SECRET=

# (Tuỳ chọn) Mã quản trị cho công cụ/script gọi API kiểm duyệt qua header x-admin-token
ADMIN_TOKEN=

# Cổng và địa chỉ lắng nghe (mặc định chỉ máy này truy cập được)
PORT=3000
HOST=127.0.0.1
